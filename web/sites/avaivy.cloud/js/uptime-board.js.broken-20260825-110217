
const WINDOWS = [
  ['1m','1 Minute'],
  ['15m','15m'],
  ['1h','1h'],
  ['8h','8h'],
  ['12h','12h'],
  ['24h','24h'],
  ['48h','48h'],
  ['3d','3 Day'],
  ['7d','7 Day'],
  ['month','Month'],
  ['year','Year'],
  ['all','All time']
];

let selectedWindow = '12h';

const label = key =>
  (WINDOWS.find(x => x[0] === key) || ['', key])[1];

const duration = seconds => {

  seconds = Number(seconds) || 0;

  const d = Math.floor(seconds / 86400);
  const h = Math.floor(
    seconds % 86400 / 3600
  );
  const m = Math.floor(
    seconds % 3600 / 60
  );

  return `${d}d ${h}h ${m}m`;
};

const percent = value =>
  value == null
    ? '—'
    : `${Number(value).toFixed(2)}%`;

function drawWindowBar(){

  const root =
    document.getElementById('timebar');

  if(!root) return;

  root.innerHTML =
    WINDOWS.map(([key,name]) => `
      <button
        class="timebtn ${
          key === selectedWindow
            ? 'active'
            : ''
        }"
        data-window="${key}">
        ${name}
      </button>
    `).join('');

  root
    .querySelectorAll('[data-window]')
    .forEach(button => {

      button.onclick = () => {

        selectedWindow =
          button.dataset.window;

        drawWindowBar();
        load();
      };
    });
}

function drawChart(rows){

  const svg =
    document.getElementById(
      'uptimeChart'
    );

  if(!svg) return;

  if(!rows.length){

    svg.innerHTML =
      '<text x="500" y="140" ' +
      'text-anchor="middle">' +
      'No uptime history in selected window' +
      '</text>';

    return;
  }

  const values =
    rows
      .map(x =>
        Number(x.uptime_seconds)
      )
      .filter(Number.isFinite);

  if(!values.length) return;

  const W = 1000;
  const H = 280;
  const L = 70;
  const R = 18;
  const T = 18;
  const B = 48;

  let lo = Math.min(...values);
  let hi = Math.max(...values);

  if(lo === hi) hi = lo + 1;

  const x = i =>
    L +
    (
      rows.length <= 1
        ? 0
        : i *
          (W - L - R) /
          (rows.length - 1)
    );

  const y = value =>
    H - B -
    (
      (value - lo) /
      (hi - lo)
    ) *
    (H - T - B);

  let html = '';

  for(let i=0;i<=4;i++){

    const yy =
      T +
      i *
      (H - T - B) / 4;

    const value =
      hi -
      i * (hi - lo) / 4;

    html +=
      `<line
        x1="${L}"
        y1="${yy}"
        x2="${W-R}"
        y2="${yy}"
      />`;

    html +=
      `<text
        x="${L-8}"
        y="${yy+4}"
        text-anchor="end"
        font-size="11">
        ${duration(value)}
      </text>`;
  }

  let path = '';

  rows.forEach((row,i) => {

    const value =
      Number(row.uptime_seconds);

    if(!Number.isFinite(value))
      return;

    path +=
      `${path ? ' L' : 'M'}`
      + `${x(i).toFixed(1)} `
      + `${y(value).toFixed(1)}`;
  });

  html +=
    `<path
      d="${path}"
      fill="none"
      stroke-width="2.5"
    />`;

  svg.innerHTML = html;
}

async function load(){

  try{

    const data =
      await fetch(
        `/api/uptime?window=${
          encodeURIComponent(
            selectedWindow
          )
        }`,
        {cache:'no-store'}
      ).then(r => r.json());

    const period =
      data.period || {};

    document.getElementById(
      'stamp'
    ).textContent =
      `Updated ${
        new Date(data.ts)
          .toLocaleString()
      } · ${label(selectedWindow)}`;

    const chartWindow =
      document.getElementById(
        'chartWindow'
      );

    if(chartWindow)
      chartWindow.textContent =
        label(selectedWindow);

    const stats =
      document.getElementById('stats');

    if(stats){

      stats.innerHTML = `

        <article class="card stat">
          <div class="label">
            Availability
          </div>
          <div class="value">
            ${percent(
              period.availability_percent
            )}
          </div>
        </article>

        <article class="card stat">
          <div class="label">
            Online
          </div>
          <div class="value">
            ${duration(
              period.online_seconds
            )}
          </div>
        </article>

        <article class="card stat">
          <div class="label">
            Offline
          </div>
          <div class="value">
            ${duration(
              period.offline_seconds
            )}
          </div>
        </article>

        <article class="card stat">
          <div class="label">
            Current uptime
          </div>
          <div class="value">
            ${duration(
              period.current_uptime_seconds
            )}
          </div>
        </article>
      `;
    }

    drawChart(
      data.history || []
    );

  }catch(error){

    console.error(
      'Uptime load failed:',
      error
    );

    const stamp =
      document.getElementById(
        'stamp'
      );

    if(stamp)
      stamp.textContent =
        'Uptime API unavailable';
  }
}

drawWindowBar();
load();
setInterval(load,10000);
