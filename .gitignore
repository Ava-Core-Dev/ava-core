# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Node / Workers
node_modules/
.wrangler/
dist/
*.tsbuildinfo

# Next.js / Vercel build output — regenerated on every build
.next/
next-env.d.ts
.vercel/
**/.pages-out/

# Secrets — never commit
.env
.env.*
!.env.example

# Runtime data — persisted on disk, not in git.
# Ignore the whole tree: it holds report output, cam stills, sqlite indexes and
# Discord/Telegram state, all of which regenerate and some of which is private.
data/
!data/**/README*

# Desktop runtime state and the symlink to the old archive's node_modules
apps/desktop/node_modules
apps/desktop/data/
**/telegram-context.json

# Audio assets — not tracked in git (binary, large).
# Canonical library: /home/ava-core/ava/media
# These are local symlinks (git sees a symlink as a file — no trailing slash).
/apps/voice/assets
/apps/media
/ava_core/

# OS
.DS_Store
Thumbs.db

credentials.env
credentials.env.*
**/recovery-phrase*
**/wallet-secrets*

# Operator private media (life story, 1:1, account exports) — never git
**/media/private/



# Cursor IDE local config — never commit
.cursor/
