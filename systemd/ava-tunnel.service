[Unit]
Description=Ava cloudflared Tunnel — ava-origin.rootmc.net
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-apps/
After=network-online.target
Wants=network-online.target
# Intentionally independent of ava-core — tunnel restarts on its own schedule
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=ava-core
Group=ava-core
ExecStart=/usr/local/bin/cloudflared tunnel \
  --config /run/media/ava-core/6B6C97406BF24558/ava-core-v2/config/tunnel.yml run

Restart=always
RestartSec=5
TimeoutStopSec=15

StandardOutput=append:/run/media/ava-core/6B6C97406BF24558/ava-core-v2/data/logs/tunnel.log
StandardError=append:/run/media/ava-core/6B6C97406BF24558/ava-core-v2/data/logs/tunnel.log

[Install]
WantedBy=multi-user.target
