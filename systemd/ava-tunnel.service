[Unit]
Description=Ava cloudflared Tunnel — ava-origin.rootmc.net
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-apps/
After=network-online.target
Wants=network-online.target
# Independent of ava-core — tunnel restarts separately
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=ava-core
Group=ava-core
ExecStart=/usr/local/bin/cloudflared tunnel --config /home/ava-core/ava/config/tunnel.yml run

Restart=always
RestartSec=5
TimeoutStopSec=15

StandardOutput=append:/home/ava-core/ava/data/logs/tunnel.log
StandardError=append:/home/ava-core/ava/data/logs/tunnel.log

[Install]
WantedBy=multi-user.target
