[Unit]
Description=Ava cloudflared Tunnel — ava-origin.rootmc.net
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-apps/
After=network-online.target
Wants=network-online.target
# Intentionally independent of ava-core — tunnel restarts on its own schedule
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=ava-core
Group=ava-core
ExecStart=/home/ava-core/.local/bin/cloudflared tunnel run \
  --token-file /home/ava-core/.cloudflared/tunnel.token

Restart=always
RestartSec=5
TimeoutStopSec=15

StandardOutput=append:/home/ava-core/ava/logs/ava-tunnel.log
StandardError=append:/home/ava-core/ava/logs/ava-tunnel.log

[Install]
WantedBy=multi-user.target
