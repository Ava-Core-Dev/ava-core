[Unit]
Description=RootMC Test Server — Paper 1.21 (user session)
Documentation=https://rootmc.net
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/ava-core/ava/workstations/minecraft-test
ExecStartPre=/bin/bash -c '! ss -tlnp | grep -q :24945'
ExecStart=/home/ava-core/ava/workstations/minecraft-test/start.sh
ExecStop=/bin/bash -c 'kill -TERM $MAINPID; sleep 10'
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
StandardOutput=append:/home/ava-core/ava/logs/minecraft-test-session.log
StandardError=append:/home/ava-core/ava/logs/minecraft-test-session.log

[Install]
WantedBy=default.target
