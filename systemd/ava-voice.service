[Unit]
Description=Ava Voice Pipeline + Stream Director
Documentation=https://avaivy.cloud
After=ava-core.service
Wants=ava-core.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
User=ava-core
Group=ava-core
WorkingDirectory=/home/ava-core/ava/ava-core-v2
Environment=PYTHONUNBUFFERED=1
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DISPLAY=:0
EnvironmentFile=-/home/ava-core/ava/ava-core-v2/.env
ExecStart=/home/ava-core/ava/ava-core-v2/.venv/bin/python -m apps.voice.director

Restart=on-failure
RestartSec=10
TimeoutStopSec=30

StandardOutput=append:/home/ava-core/ava/logs/ava-voice.log
StandardError=append:/home/ava-core/ava/logs/ava-voice.log

[Install]
WantedBy=multi-user.target
