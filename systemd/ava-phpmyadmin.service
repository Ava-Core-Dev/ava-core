[Unit]
Description=phpMyAdmin — local DB admin UI on :8890
After=mariadb.service network.target
Wants=mariadb.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=ava-core
Group=ava-core
# phpMyAdmin served via PHP built-in web server (no Apache/nginx required)
# Access at http://localhost:8890/
ExecStart=/usr/bin/php -S 127.0.0.1:8890 -t /usr/share/phpmyadmin

Restart=on-failure
RestartSec=5

StandardOutput=append:/home/ava-core/ava/logs/ava-phpmyadmin.log
StandardError=append:/home/ava-core/ava/logs/ava-phpmyadmin.log

[Install]
WantedBy=multi-user.target
