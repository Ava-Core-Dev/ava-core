{
  "name": "ava-workers",
  "version": "2.0.0",
  "private": true,
  "description": "Ava Cloudflare Workers — rootmc.info, avaivy.cloud, rootrecord.online",
  "scripts": {
    "deploy:ava-api": "wrangler deploy -c wrangler.ava-api.toml",
    "deploy:rootrecord-api": "wrangler deploy -c wrangler.rootrecord-api.toml",
    "deploy:rootmc-api": "wrangler deploy -c wrangler.rootmc-api.toml",
    "dev:ava-api": "wrangler dev -c wrangler.ava-api.toml",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.80.0"
  }
}
