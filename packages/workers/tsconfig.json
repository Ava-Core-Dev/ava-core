{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "../shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/**/*.ts"],
  // ava-cron-kick.ts imports nine rootmc-api modules that were never migrated
  // from the old tree. Excluded so it cannot block deploys of the other
  // workers; restore it once those modules exist.
  "exclude": ["node_modules", "src/rootmc-api/ava-cron-kick.ts"]
}
