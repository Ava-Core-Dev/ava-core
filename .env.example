# ── Ava Core ──────────────────────────────────────────────────────────────────
AVA_HOME=/home/ava-core/ava           # canonical handoff root
AVA_PORT=8787                         # HTTP server port
AVA_ENV=production                    # production | development

# ── xAI / Grok ────────────────────────────────────────────────────────────────
XAI_API_KEY=
GROK_MODEL=grok-4.6
TTS_VOICE=ara
VOICE_MODE=grok                       # grok | local | disabled

# ── Discord ───────────────────────────────────────────────────────────────────
AVA_DISCORD_BOT_TOKEN=
AVA_DISCORD_APPLICATION_ID=1532751879875072070
ROOTMC_GUILD_ID=1516108585740800042

# ── Slack ─────────────────────────────────────────────────────────────────────
AVA_SLACK_BOT_TOKEN=
AVA_SLACK_APP_TOKEN=
AVA_SLACK_BOT_USER_ID=
AVA_SLACK_SOLAR_FEED_CHANNEL=

# ── Telegram ──────────────────────────────────────────────────────────────────
AVA_TELEGRAM_BOT_TOKEN=
AVA_TELEGRAM_ENABLED=1

# ── Ollama (local brain) ──────────────────────────────────────────────────────
AVA_OLLAMA_URL=http://127.0.0.1:11434
AVA_OLLAMA_MODEL=ava-ivy

# ── OBS WebSocket ─────────────────────────────────────────────────────────────
OBS_WS_URL=ws://localhost:4455
OBS_WS_PASSWORD=

# ── Cloudflare ────────────────────────────────────────────────────────────────
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_D1_HEARTBEAT_DB_ID=               # D1 database for heartbeat

# ── MySQL / Economy ───────────────────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=rootmc_economy

# ── YouTube ───────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# ── Voice / Audio ─────────────────────────────────────────────────────────────
HOURLY_CHIME=true
HOURLY_ANNOUNCE_TIME=true
HOURLY_CHIME_VOLUME=0.8
MAX_SECONDS=55
POLL_INTERVAL=30
ENABLE_SCHEDULER=true
