/**
 * Sample + store connection metrics for /status/connections:
 * - ingame players (Minecraft list ping)
 * - server online (0/1)
 * - app sessions (people logged into apps — D1 license_sessions recent)
 */
import fs from "node:fs";
import path from "node:path";
import net from "node:net";
import { storePaths } from "./store.mjs";

const WINDOW_MS = 8 * 60 * 60 * 1000;
const ACTIVE_SESSION_MINUTES = 30;

function connDir() {
  const dir = path.join(storePaths().dir, "connections");
  fs.mkdirSync(dir, { recursive: true });
  return dir;
}

function minutesPath() {
  return path.join(connDir(), "minutes.jsonl");
}

function varint(n) {
  const out = [];
  while (true) {
    if ((n & ~0x7f) === 0) {
      out.push(n);
      break;
    }
    out.push((n & 0x7f) | 0x80);
    n >>>= 7;
  }
  return Buffer.from(out);
}

function readVarInt(buf, offset) {
  let num = 0;
  let shift = 0;
  let o = offset;
  while (true) {
    if (o >= buf.length) throw new Error("short");
    const b = buf[o++];
    num |= (b & 0x7f) << shift;
    if ((b & 0x80) === 0) break;
    shift += 7;
    if (shift > 35) throw new Error("varint");
  }
  return [num, o];
}

/** Minecraft Server List Ping → online player count */
export function minecraftListPing(host, port, timeoutMs = 4500) {
  return new Promise((resolve) => {
    const socket = net.createConnection({ host, port });
    let buf = Buffer.alloc(0);
    let done = false;
    const finish = (result) => {
      if (done) return;
      done = true;
      try {
        socket.destroy();
      } catch {
        /* ignore */
      }
      resolve(result);
    };
    socket.setTimeout(timeoutMs);
    socket.on("timeout", () => finish({ ok: false, reason: "timeout", host, port }));
    socket.on("error", (e) => finish({ ok: false, reason: e.message, host, port }));
    socket.on("connect", () => {
      const hostBuf = Buffer.from(host, "utf8");
      const portBuf = Buffer.alloc(2);
      portBuf.writeUInt16BE(port & 0xffff);
      const data = Buffer.concat([
        varint(0x00),
        varint(47),
        varint(hostBuf.length),
        hostBuf,
        portBuf,
        varint(1),
      ]);
      const handshake = Buffer.concat([varint(data.length), data]);
      const statusReq = Buffer.concat([varint(1), Buffer.from([0x00])]);
      socket.write(Buffer.concat([handshake, statusReq]));
    });
    socket.on("data", (chunk) => {
      buf = Buffer.concat([buf, chunk]);
      try {
        let o = 0;
        const [pktLen, o1] = readVarInt(buf, o);
        o = o1;
        if (buf.length < o + pktLen) return;
        const [packetId, o2] = readVarInt(buf, o);
        o = o2;
        if (packetId !== 0) return finish({ ok: false, reason: "bad_packet", host, port });
        const [strLen, o3] = readVarInt(buf, o);
        o = o3;
        if (buf.length < o + strLen) return;
        const json = buf.slice(o, o + strLen).toString("utf8");
        const d = JSON.parse(json);
        finish({
          ok: true,
          online: true,
          players: d?.players?.online ?? null,
          max: d?.players?.max ?? null,
          version: d?.version?.name ?? null,
          host,
          port,
        });
      } catch {
        /* wait */
      }
    });
  });
}

function pingTargets() {
  const playHost = String(process.env.ROOTMC_PLAY_HOST || "play.rootmc.net").trim();
  // PRIMARY ONLY — dual Towny/Claims framing retired; keep legacy probes only if env still set
  const primaryHost = String(process.env.AVA_RCON_PRIMARY_HOST || process.env.ROOTMC_PRIMARY_GAME_HOST || "").trim();
  const primaryPort = Number(process.env.ROOTMC_PRIMARY_GAME_PORT || process.env.ROOTMC_TOWNY_GAME_PORT || 25565);
  if (primaryHost) out.push({ id: "primary", host: primaryHost, port: primaryPort });

  const claimsHost = String(process.env.AVA_RCON_CLAIMS_HOST || "").trim();
  const townyHost = String(process.env.AVA_RCON_TOWNY_HOST || "").trim();
  const claimsPort = Number(process.env.ROOTMC_CLAIMS_GAME_PORT || 24945);
  const townyPort = Number(process.env.ROOTMC_TOWNY_GAME_PORT || 25565);
  const out = [];
  if (playHost) out.push({ id: "play", host: playHost, port: 25565 });
  if (townyHost) out.push({ id: "towny", host: townyHost, port: townyPort });
  if (claimsHost) out.push({ id: "claims", host: claimsHost, port: claimsPort });
  // de-dupe host:port
  const seen = new Set();
  return out.filter((t) => {
    const k = `${t.host}:${t.port}`;
    if (seen.has(k)) return false;
    seen.add(k);
    return true;
  });
}

async function sampleMinecraft() {
  const targets = pingTargets();
  const results = [];
  for (const t of targets) {
    results.push({ ...t, ...(await minecraftListPing(t.host, t.port)) });
  }
  const onlineServers = results.filter((r) => r.ok);
  const players = onlineServers.reduce(
    (sum, r) => sum + (Number.isFinite(Number(r.players)) ? Number(r.players) : 0),
    0,
  );
  return {
    serverOnline: onlineServers.length > 0 ? 1 : 0,
    players,
    maxPlayers: onlineServers.reduce(
      (m, r) => Math.max(m, Number(r.max) || 0),
      0,
    ),
    servers: results.map((r) => ({
      id: r.id,
      host: r.host,
      port: r.port,
      ok: Boolean(r.ok),
      players: r.players ?? null,
      max: r.max ?? null,
      version: r.version ?? null,
      reason: r.reason || null,
    })),
  };
}

async function sampleAppSessions() {
  const base = String(
    process.env.ROOTRECORD_ACCOUNT_API_URL ||
      "https://rootrecord-api-account.rootrecord.workers.dev",
  ).replace(/\/$/, "");
  const key = String(process.env.RR_PUSH_ADMIN_SECRET || "").trim();
  if (key) {
    try {
      const res = await fetch(`${base}/api/internal/connection-stats`, {
        headers: { "X-RR-Push-Admin-Key": key },
        signal: AbortSignal.timeout(8000),
      });
      if (res.ok) {
        const d = await res.json();
        if (d && (d.active_sessions != null || d.app_sessions != null)) {
          return {
            appSessions: Number(d.app_sessions ?? d.active_sessions) || 0,
            source: "account-api",
            detail: d,
          };
        }
      }
    } catch {
      /* try D1 */
    }
  }

  const accountId = String(
    process.env.CLOUDFLARE_ACCOUNT_ID || "2b317e91da019f4fdb854e3b8e26fa94",
  ).trim();
  // Prefer Root Record account for D1 (wiki/account DB lives there)
  const rrAccountId = "2b317e91da019f4fdb854e3b8e26fa94";
  const token = String(process.env.CLOUDFLARE_API_TOKEN || "").trim();
  const globalKey = String(
    process.env.CLOUDFLARE_GLOBAL_API_KEY || process.env.CLOUDFLARE_API_KEY || "",
  ).trim();
  const email = String(process.env.CLOUDFLARE_EMAIL || "").trim();
  const dbId = String(
    process.env.D1_DATABASE_ID || "0b49c598-1f91-4a09-84a8-6ba8241c6df3",
  ).trim();
  if ((!token && !(globalKey && email)) || !dbId) {
    return { appSessions: null, source: "unavailable", detail: "no_d1_auth" };
  }
  const sql = `SELECT
      COUNT(*) AS active_sessions,
      COUNT(DISTINCT account_id) AS active_accounts
    FROM license_sessions
    WHERE revoked_at IS NULL
      AND last_seen_at IS NOT NULL
      AND julianday(last_seen_at) >= julianday('now', '-${ACTIVE_SESSION_MINUTES} minutes')`;

  async function query(acc, headers) {
    const res = await fetch(
      `https://api.cloudflare.com/client/v4/accounts/${acc}/d1/database/${dbId}/query`,
      {
        method: "POST",
        headers: { "Content-Type": "application/json", ...headers },
        body: JSON.stringify({ sql }),
        signal: AbortSignal.timeout(12000),
      },
    );
    const d = await res.json();
    return { res, d };
  }

  try {
    let d = null;
    // Global key on RR account is the reliable path on OptiPlex
    if (globalKey && email) {
      const r = await query(rrAccountId, {
        "X-Auth-Email": email,
        "X-Auth-Key": globalKey,
      });
      d = r.d;
      if (!r.d?.success && token) {
        const r2 = await query(accountId, { Authorization: `Bearer ${token}` });
        d = r2.d;
      }
    } else if (token) {
      const r = await query(accountId, { Authorization: `Bearer ${token}` });
      d = r.d;
    }
    const block = Array.isArray(d?.result) ? d.result[0] : d?.result;
    const row =
      (block && Array.isArray(block.results) && block.results[0]) ||
      (block && Array.isArray(block.rows) && block.rows[0]) ||
      null;
    if (!d?.success || !row) {
      return {
        appSessions: null,
        source: "d1",
        detail: (d?.errors && d.errors[0]?.message) || "d1_query_failed",
      };
    }
    const n = Number(row.active_sessions ?? row[0] ?? 0);
    return {
      appSessions: Number.isFinite(n) ? n : 0,
      activeAccounts: Number(row.active_accounts ?? row[1] ?? 0) || 0,
      source: "d1",
      windowMinutes: ACTIVE_SESSION_MINUTES,
    };
  } catch (e) {
    return { appSessions: null, source: "d1", detail: e.message };
  }
}

function appendMinute(row) {
  const file = minutesPath();
  fs.appendFileSync(file, JSON.stringify(row) + "\n", "utf8");
  // prune old
  try {
    const lines = fs.readFileSync(file, "utf8").split(/\r?\n/).filter(Boolean);
    const cut = Date.now() - WINDOW_MS - 60 * 60 * 1000;
    const kept = lines.filter((ln) => {
      try {
        return Number(JSON.parse(ln).t) >= cut;
      } catch {
        return false;
      }
    });
    if (kept.length < lines.length) fs.writeFileSync(file, kept.join("\n") + "\n", "utf8");
  } catch {
    /* ignore prune errors */
  }
}

function readMinutes(hours = 8) {
  const file = minutesPath();
  if (!fs.existsSync(file)) return [];
  const since = Date.now() - Math.max(1, hours) * 60 * 60 * 1000;
  const out = [];
  for (const ln of fs.readFileSync(file, "utf8").split(/\r?\n/)) {
    if (!ln.trim()) continue;
    try {
      const row = JSON.parse(ln);
      if (Number(row.t) >= since) out.push(row);
    } catch {
      /* skip */
    }
  }
  return out.sort((a, b) => a.t - b.t);
}

function densify(rows, hours = 8) {
  const end = Date.now();
  const start = end - hours * 60 * 60 * 1000;
  const byMin = new Map();
  for (const r of rows) {
    const k = Math.floor(Number(r.t) / 60000) * 60000;
    byMin.set(k, r);
  }
  const out = [];
  for (let t = Math.floor(start / 60000) * 60000; t <= end; t += 60000) {
    const r = byMin.get(t);
    out.push({
      t,
      players: r?.players ?? null,
      serverOnline: r?.serverOnline ?? null,
      appSessions: r?.appSessions ?? null,
    });
  }
  return out;
}

export async function sampleConnectionsOnce() {
  const mc = await sampleMinecraft();
  const apps = await sampleAppSessions();
  const row = {
    t: Date.now(),
    players: mc.players,
    serverOnline: mc.serverOnline,
    appSessions: apps.appSessions,
    maxPlayers: mc.maxPlayers,
    servers: mc.servers,
    apps,
  };
  appendMinute(row);
  fs.writeFileSync(path.join(connDir(), "latest.json"), JSON.stringify(row, null, 2));
  return row;
}

export async function buildConnectionsDashboardPayload(opts = {}) {
  const hours = Math.min(48, Math.max(1, Number(opts.hours) || 8));
  let latest = null;
  try {
    latest = JSON.parse(fs.readFileSync(path.join(connDir(), "latest.json"), "utf8"));
  } catch {
    /* none */
  }
  // refresh if stale (>2.5 min) or missing
  const stale =
    !latest || !latest.t || Date.now() - Number(latest.t) > 150_000;
  if (stale) {
    try {
      latest = await sampleConnectionsOnce();
    } catch (e) {
      latest = latest || {
        t: Date.now(),
        players: null,
        serverOnline: 0,
        appSessions: null,
        error: e.message,
      };
    }
  }
  const minutes = densify(readMinutes(hours), hours);
  const livePlayers = latest?.players ?? null;
  const liveOnline = latest?.serverOnline ?? 0;
  const liveApps = latest?.appSessions ?? null;
  const avg = (vals) => {
    const n = vals.filter((v) => v != null && Number.isFinite(Number(v)));
    if (!n.length) return null;
    return Math.round((n.reduce((a, b) => a + Number(b), 0) / n.length) * 10) / 10;
  };
  return {
    ok: true,
    service: "ava-ivy",
    updatedAt: latest?.t ? new Date(latest.t).toISOString() : new Date().toISOString(),
    live: {
      players: livePlayers,
      serverOnline: Boolean(liveOnline),
      appSessions: liveApps,
      maxPlayers: latest?.maxPlayers ?? null,
      servers: latest?.servers || [],
      appsSource: latest?.apps?.source || null,
      appsWindowMinutes: ACTIVE_SESSION_MINUTES,
    },
    stats: {
      playersAvg: avg(minutes.map((m) => m.players)),
      serverOnlinePct: (() => {
        const n = minutes.filter((m) => m.serverOnline != null);
        if (!n.length) return null;
        return Math.round(
          (n.filter((m) => Number(m.serverOnline) > 0).length / n.length) * 1000,
        ) / 10;
      })(),
      appSessionsAvg: avg(minutes.map((m) => m.appSessions)),
    },
    series: {
      hours,
      sampleCount: minutes.filter(
        (m) => m.players != null || m.serverOnline != null || m.appSessions != null,
      ).length,
      minutes,
    },
  };
}
