.player-world-list { margin: 0; padding-left: 1.15rem; font-size: 0.92rem; }

/* =====================  Shops page  ===================== */

.shops-wrap { max-width: 60rem; margin: 0 auto; padding: 2rem 0 3rem; }
.shops-wrap h1 {
  font-family: var(--rmc-font-display);
