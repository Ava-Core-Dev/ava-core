{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "../rootmc-realm-api/src/**/*.ts",
    "../rootrecord-api-account/src/**/*.ts",
    "../shared/**/*.ts"
  ]
}
