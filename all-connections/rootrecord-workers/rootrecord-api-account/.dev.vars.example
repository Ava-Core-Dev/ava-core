# Copy to .dev.vars in this folder for `wrangler dev` (file is gitignored).
# Use the same JWT_SECRET value you deploy to production if you need local auth to match.

JWT_SECRET=replace-with-long-random-string-at-least-16-chars

# AES-256 key for custodial wallet private keys (exactly 32 bytes as standard base64). deploy.ps1 generates/uploads this for production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTERNAL_WALLET_ENC_KEY_B64=paste-44-char-base64-here

# Stripe annual price for Visiting Hawaiʻi sponsored listings ($100/year):
# STRIPE_VISITING_HAWAII_SPONSORED_PRICE_ID=price_...

# Optional local overrides (otherwise wrangler.toml [vars] apply):
# SITE_URL=http://127.0.0.1:8787
# ACCUWEATHER_API_KEY=   (AccuWeather dev key for real weather in local dev)
#
# Optional: override wrangler.toml [vars] for local dev only:
# DISCORD_PUBLIC_KEY=paste_hex_verify_key_here
#
# Root Economy bot (local dev):
# DISCORD_ECONOMY_BOT_TOKEN=
# DISCORD_ECONOMY_PUBLIC_KEY=46d0a100a886776b944bb67e666827363419ab91058b9e31c2eff7ca5f1d4815
# DISCORD_ECONOMY_CLIENT_ID=1513252482229338324
#
# App session start → Discord (POST /api/app-session/start from mobile/web apps):
# DISCORD_APP_SESSION_WEBHOOK_URL=https://discord.com/api/webhooks/…
#
# Root Economy Discord webhook (community donations, swaps, deposits; optional manual ping):
# DISCORD_ROOT_ECONOMY_WEBHOOK_URL=https://discord.com/api/webhooks/…
# Scheduled "Internal circulation" pings are OFF unless ROOT_ECONOMY_DISCORD_CRON_ENABLED=1 (wrangler var).
# Manual ping: POST /api/internal/root-economy-discord-ping (X-RR-Push-Admin-Key).
